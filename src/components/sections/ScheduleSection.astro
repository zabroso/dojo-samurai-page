---
import type { ScheduleBlock } from '../../types/index'

const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']

// slots[0]=Lunes  slots[1]=Martes  slots[2]=Miércoles  slots[3]=Jueves  slots[4]=Viernes  slots[5]=Sábado
const blocks: ScheduleBlock[] = [
  { hora: '08:30', slots: [null,               'Adulto General',      null,               'Adulto General',      null,              null             ] },
  { hora: '10:30', slots: [null,               null,                  null,               null,                  null,              'Adulto General' ] },
  { hora: '17:00', slots: ['Infantil Básico',  'Pre Infantil Básico', 'Infantil Básico',  'Pre Infantil Básico', null,              null             ] },
  { hora: '18:00', slots: [null,               'Juvenil Básico',      null,               'Juvenil Básico',      null,              null             ] },
  { hora: '19:00', slots: ['Adulto Avanzado',  null,                  'Adulto Avanzado',  null,                  'Adulto Avanzado', null             ] },
  { hora: '20:00', slots: ['Adulto Intermedio',null,                  'Adulto Intermedio',null,                  null,              null             ] },
  { hora: '20:15', slots: [null,               'Adulto Básico',       null,               'Adulto Básico',       null,              null             ] },
]

const groupColors: Record<string, string> = {
  'Pre Infantil Básico': 'bg-emerald-50 text-emerald-800',
  'Infantil Básico':     'bg-sky-50 text-sky-800',
  'Juvenil Básico':      'bg-violet-50 text-violet-800',
  'Adulto General':      'bg-amber-50 text-amber-800',
  'Adulto Básico':       'bg-orange-50 text-orange-800',
  'Adulto Avanzado':     'bg-red-50 text-red-800',
  'Adulto Intermedio':   'bg-rose-50 text-rose-800',
}
---

<section class="py-32 bg-white" id="horarios">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-jka-red font-bold text-xs uppercase tracking-widest mb-4 block">
        Tu rutina
      </span>
      <h2 class="font-h-display text-7xl text-ink uppercase tracking-tight">
        Horarios del Dojo
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-surface border-b-2 border-jka-red">
            <th class="p-5 text-left font-bold uppercase text-sm tracking-widest w-28">Hora</th>
            {days.map((day) => (
              <th class="p-5 text-center font-bold uppercase text-sm tracking-widest">{day}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {blocks.map((block) => (
            <tr class="border-b border-border last:border-0">
              <td class="p-5 font-bold text-ink text-lg tabular-nums">{block.hora}</td>
              {block.slots.map((group) => (
                <td class="p-4 text-center">
                  {group
                    ? (
                      <span class:list={['inline-block w-full font-bold text-sm px-3 py-3 rounded-xl', groupColors[group]]}>
                        {group}
                      </span>
                    )
                    : <span class="text-muted">—</span>
                  }
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
