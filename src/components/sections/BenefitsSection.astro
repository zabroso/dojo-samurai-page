---
import BenefitCard from '../ui/BenefitCard.astro'
import type { Benefit } from '../../types/index'

const benefits: Benefit[] = [
  {
    id: '1',
    icon: 'military_tech',
    title: 'Instructores certificados JKA',
    description: 'Los instructores de nuestro dojo cuentan con licencia oficial emitida por JKA Japón. Esta certificación requiere años de experiencia, rendir examen técnico y poseer grado mínimo de 2º dan.',
  },
  {
    id: '2',
    icon: 'language',
    title: 'Grados con reconocimiento internacional',
    description: 'El sistema de grados de JKA Chile forma parte de una estructura internacional. Los grados de cinturón negro son registrados en Japón, manteniendo una línea técnica común con la Japan Karate Association.',
  },
  {
    id: '3',
    icon: 'school',
    title: 'Enseñanza con enfoque pedagógico',
    description: 'Nuestro sensei Raúl Puchi es Profesor de Estado en Biología, y su formación docente se refleja en una enseñanza clara, progresiva y responsable. Además, nuestros instructores son profesionales en distintas áreas.',
  },
  {
    id: '4',
    icon: 'history_edu',
    title: 'Tradición, experiencia y práctica activa',
    description: 'Contamos con 50 años de historia formando karatekas. Participamos regularmente en actividades oficiales de JKA, como seminarios, torneos, exámenes y encuentros técnicos, manteniendo vivo el aprendizaje constante.',
  },
]
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 text-center mb-16">
    <span class="text-jka-red font-bold text-xs uppercase tracking-widest mb-4 block">
      ¿Por qué elegir Samurai JKA?
    </span>
    <h2 class="font-h-display text-5xl text-ink uppercase mb-4 tracking-tight">
      Formación de Excelencia
    </h2>
    <p class="text-muted max-w-2xl mx-auto text-lg leading-relaxed">
      No es solo deporte. Es un camino de vida basado en el respeto y la disciplina técnica.
    </p>
  </div>

  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {benefits.map((benefit) => (
      <BenefitCard
        icon={benefit.icon}
        title={benefit.title}
        description={benefit.description}
      />
    ))}
  </div>
</section>
