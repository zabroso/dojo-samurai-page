---
import ProgramCard from '../ui/ProgramCard.astro'
import type { Program } from '../../types/index'
import { img, WHATSAPP_BASE } from '../../config'

const programs: Program[] = [
  {
    id: 'preinfantil',
    ageRange: 'Desde 5 años',
    label: 'Formación desde pequeños',
    name: 'Pre-infantil',
    features: ['Mejora psicomotricidad', 'Disciplina y enfoque', 'Respeto y valores'],
    imageUrl: img('/images/programs/infantil.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate Infantil',
  },
  {
    id: 'infantil',
    ageRange: 'Desde 5 años',
    label: 'Formación desde pequeños',
    name: 'Infantil',
    features: ['Mejora psicomotricidad', 'Disciplina y enfoque', 'Respeto y valores'],
    imageUrl: img('/images/programs/infantil.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate Infantil',
  },
  {
    id: 'juvenil',
    ageRange: '13 a 17 años',
    label: 'Confianza y carácter',
    name: 'Juveniles',
    features: ['Fortalece autoestima', 'Condición física ideal', 'Defensa personal real'],
    imageUrl: img('/images/programs/infantil.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate Juvenil',
  },
]

const featured: Program = {
  id: 'adultos',
  ageRange: 'Adultos & Senior',
  label: 'Salud + disciplina',
  name: 'Adultos',
  features: ['Salud cardiovascular', 'Eliminación de estrés', 'Entrenamiento funcional'],
  imageUrl: img('/images/programs/adulto.jpg'),
  whatsappMessage: 'Hola, quiero información sobre el programa de Karate para Adultos',
  featured: true,
}

const featuredHref = `${WHATSAPP_BASE}?text=${encodeURIComponent(featured.whatsappMessage)}`
---

<section class="py-24 bg-surface" id="programas">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="max-w-xl">
        <span class="text-jka-red font-bold text-xs uppercase tracking-widest mb-2 block">Opción B</span>
        <h2 class="font-h-display text-5xl text-ink uppercase tracking-tight">
          Karate para todas las edades
        </h2>
        <p class="text-muted text-lg mt-4">
          Encuentra el camino diseñado para tu etapa de vida y objetivos personales.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      {programs.map((program) => (
        <ProgramCard program={program} />
      ))}
    </div>

    <div class="bg-white rounded-3xl overflow-hidden border-2 border-jka-red shadow-2xl flex flex-col md:flex-row">
      <div class="md:w-2/5 h-64 md:h-auto overflow-hidden relative">
        <span class="absolute top-4 right-4 z-10 bg-jka-red text-white text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-lg">
          Más Popular
        </span>
        <img
          src={featured.imageUrl}
          alt={`Programa de karate ${featured.name}`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="md:w-3/5 p-10 flex flex-col justify-center">
        <div class="flex justify-between items-start mb-4">
          <span class="px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest rounded-full text-jka-red bg-jka-red/10">
            {featured.ageRange}
          </span>
          <span class="text-jka-red font-bold text-[10px] uppercase tracking-wider">{featured.label}</span>
        </div>
        <h3 class="font-h-display text-5xl text-ink mb-6">{featured.name}</h3>
        <ul class="text-ink text-sm space-y-3 mb-8">
          {featured.features.map((feature) => (
            <li class="flex items-center gap-2 font-bold">
              <span class="material-symbols-outlined text-lg text-jka-red">check_circle</span>
              {feature}
            </li>
          ))}
        </ul>
        <a
          href={featuredHref}
          target="_blank"
          rel="noreferrer"
          class="inline-block bg-jka-red text-white text-center py-4 px-8 rounded-xl font-bold hover:bg-jka-red-dark jka-transition shadow-xl text-sm uppercase tracking-wider self-start"
        >
          Consultar disponibilidad
        </a>
      </div>
    </div>
  </div>
</section>
