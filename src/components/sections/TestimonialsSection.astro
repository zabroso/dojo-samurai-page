---

<section class="py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-jka-red font-bold text-xs uppercase tracking-widest block mb-4">
        Lo que dicen de nosotros
      </span>
      <h2 class="font-h-display text-5xl text-ink mb-4">
        Impacto en Nuestra Comunidad
      </h2>
      <div class="flex items-center justify-center gap-2">
        <div class="flex text-yellow-400">
          {Array.from({ length: 5 }).map(() => (
            <span class="material-symbols-outlined text-xl">star</span>
          ))}
        </div>
        <span class="font-black text-ink">4.9/5 en Google</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {testimonials.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} />
      ))}
    </div>
  </div>
</section>
