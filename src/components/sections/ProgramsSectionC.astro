---
import type { Program } from '../../types/index'
import { img, WHATSAPP_BASE } from '../../config'

const programs: Program[] = [
  {
    id: 'preinfantil',
    ageRange: 'Desde 5 años',
    label: 'Formación desde pequeños',
    name: 'Pre-infantil',
    features: ['Mejora psicomotricidad', 'Disciplina y enfoque', 'Respeto y valores'],
    imageUrl: img('/images/programs/infantil.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate Infantil',
  },
  {
    id: 'infantil',
    ageRange: 'Desde 5 años',
    label: 'Formación desde pequeños',
    name: 'Infantil',
    features: ['Mejora psicomotricidad', 'Disciplina y enfoque', 'Respeto y valores'],
    imageUrl: img('/images/programs/infantil.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate Infantil',
  },
  {
    id: 'juvenil',
    ageRange: '13 a 17 años',
    label: 'Confianza y carácter',
    name: 'Juveniles',
    features: ['Fortalece autoestima', 'Condición física ideal', 'Defensa personal real'],
    imageUrl: img('/images/programs/infantil.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate Juvenil',
  },
  {
    id: 'adultos',
    ageRange: 'Adultos & Senior',
    label: 'Salud + disciplina',
    name: 'Adultos',
    features: ['Salud cardiovascular', 'Eliminación de estrés', 'Entrenamiento funcional'],
    imageUrl: img('/images/programs/adulto.jpg'),
    whatsappMessage: 'Hola, quiero información sobre el programa de Karate para Adultos',
    featured: true,
  },
]
---

<section class="py-24 bg-white" id="programas-c">
  <div class="max-w-5xl mx-auto px-6">
    <div class="mb-16">
      <span class="text-jka-red font-bold text-xs uppercase tracking-widest mb-2 block">Opción C</span>
      <h2 class="font-h-display text-5xl text-ink uppercase tracking-tight">
        Karate para todas las edades
      </h2>
      <p class="text-muted text-lg mt-4 max-w-xl">
        Encuentra el camino diseñado para tu etapa de vida y objetivos personales.
      </p>
    </div>

    <div class="flex flex-col gap-6">
      {programs.map((program) => {
        const href = `${WHATSAPP_BASE}?text=${encodeURIComponent(program.whatsappMessage)}`
        return (
          <div
            class:list={[
              'flex flex-col sm:flex-row gap-0 overflow-hidden rounded-2xl border jka-transition group',
              program.featured
                ? 'border-2 border-jka-red shadow-2xl'
                : 'border-border hover:shadow-lg hover:border-jka-red/30',
            ]}
          >
            <div class="sm:w-48 sm:shrink-0 h-48 sm:h-auto overflow-hidden relative">
              {program.featured && (
                <span class="absolute top-3 left-3 z-10 bg-jka-red text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest shadow">
                  Más Popular
                </span>
              )}
              <img
                src={program.imageUrl}
                alt={`Programa de karate ${program.name}`}
                class="w-full h-full object-cover group-hover:scale-105 jka-transition"
                loading="lazy"
              />
            </div>

            <div class:list={['flex-grow p-8 flex flex-col sm:flex-row items-start sm:items-center gap-6', program.featured ? 'bg-white' : 'bg-white']}>
              <div class="flex-grow">
                <div class="flex items-center gap-3 mb-2">
                  <span
                    class:list={[
                      'px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest rounded-full text-jka-red',
                      program.featured ? 'bg-jka-red/10' : 'bg-surface',
                    ]}
                  >
                    {program.ageRange}
                  </span>
                  <span class="text-muted font-bold text-[10px] uppercase tracking-wider">{program.label}</span>
                </div>
                <h3 class="font-h-display text-3xl text-ink mb-4">{program.name}</h3>
                <ul class="flex flex-wrap gap-x-6 gap-y-1">
                  {program.features.map((feature) => (
                    <li class:list={['flex items-center gap-1.5 text-sm', program.featured ? 'font-bold text-ink' : 'text-muted']}>
                      <span class:list={['material-symbols-outlined text-base', program.featured ? 'text-jka-red' : 'text-green-500']}>
                        check_circle
                      </span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={href}
                target="_blank"
                rel="noreferrer"
                class:list={[
                  'shrink-0 py-3 px-6 rounded-xl font-bold jka-transition text-sm uppercase tracking-wider text-center',
                  program.featured
                    ? 'bg-jka-red text-white hover:bg-jka-red-dark shadow-xl'
                    : 'bg-surface text-ink group-hover:bg-jka-red group-hover:text-white',
                ]}
              >
                Consultar
              </a>
            </div>
          </div>
        )
      })}
    </div>
  </div>
</section>
